APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# =====================================================================
# 数据存储位置（支持同步盘多终端共享）
# =====================================================================
# DATA_DIR 就是应用存放所有数据的总目录，里面包括：
#   - 录音列表和任务记录（数据库文件 app.db）
#   - 原始音频文件（recordings/）
#   - 处理后的音频（normalized/）
#
# 默认路径 ../data 表示与 backend 同级的 data 文件夹，数据只在当前电脑。
#
# 如果你想多台电脑共享同一份数据（比如用 OneDrive / Syncthing 同步）：
# 把 DATA_DIR 改成同步盘里的一个文件夹即可，例如：
#   DATA_DIR=D:\OneDrive\AI-Recorder数据
#   DATA_DIR=D:\Syncthing\ai-recorder\data
#
# 也就是把这个文件夹"搬"到同步盘里，所有电脑就会自动看到同一份数据。
#
# 注意事项：
#   1. TRANSCRIPT_DIR 和 SUMMARY_DIR（转写和摘要的导出目录）可以在前端随时改
#   2. 模型文件（MODEL_DIR）和日志（LOG_DIR）不要放在同步盘，每台电脑独立即可
#   3. 应用打开文件时会自动等待同步盘下载完成，不用手动设置"始终保留"
#   4. 每台电脑各跑自己的 localhost:8000，互不冲突
# =====================================================================
DATA_DIR=../data
MODEL_DIR=../models/funasr
LOG_DIR=../logs
TRANSCRIPT_DIR=../data/transcripts
SUMMARY_DIR=../data/summaries
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_SECONDS=600

ASR_DEVICE=cpu
ASR_MODEL=paraformer-zh
ASR_VAD_MODEL=fsmn-vad
ASR_PUNC_MODEL=ct-punc
ASR_TIMESTAMP_MODEL=fa-zh
ASR_ENABLE_DIARIZATION=false
ASR_MAX_CONCURRENCY=1

# Supported: deepseek, tongyi/qwen, mimo
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_COMPLETION_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=3
LLM_TEMPERATURE=
LLM_TOP_P=

# Xiaomi MiMo OpenAI-compatible path:
# LLM_PROVIDER=mimo
# MIMO_API_KEY=your_mimo_api_key
# MIMO_THINKING=disabled
MIMO_API_KEY=
MIMO_THINKING=disabled

WATCH_ENABLED=false
WATCH_DIR=
WATCH_RECURSIVE=true
WATCH_INTERVAL_SECONDS=10
WATCH_STABLE_COUNT=2

API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Remote Access Configuration
# Remote access is enabled by default
REMOTE_ACCESS_ENABLED=true
REMOTE_ACCESS_PROVIDER=cloudflare
REMOTE_ACCESS_HOSTNAME=
REMOTE_ACCESS_TUNNEL_NAME=ai-recorder
REMOTE_ACCESS_TUNNEL_ID=
REMOTE_ACCESS_CONFIG_PATH=
REMOTE_ACCESS_PID_PATH=
REMOTE_ACCESS_LOG_PATH=
REMOTE_ACCESS_AUTO_START=true
