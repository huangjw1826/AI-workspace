APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

DATA_DIR=../data
MODEL_DIR=../models/funasr
LOG_DIR=../logs
TRANSCRIPT_DIR=../data/transcripts
SUMMARY_DIR=../data/summaries
FFMPEG_BIN=../.tools/ffmpeg/ffmpeg.exe

ASR_DEVICE=cpu
ASR_MODEL=../models/funasr/models/iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
ASR_VAD_MODEL=../models/funasr/models/iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
ASR_PUNC_MODEL=../models/funasr/models/iic/punc_ct-transformer_cn-en-common-vocab471067-large
ASR_TIMESTAMP_MODEL=fa-zh
ASR_ENABLE_DIARIZATION=false
ASR_MAX_CONCURRENCY=1

# Supported: deepseek, tongyi/qwen, mimo
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_COMPLETION_TOKENS=2048
LLM_TEMPERATURE=
LLM_TOP_P=

# Xiaomi MiMo OpenAI-compatible path:
# LLM_PROVIDER=mimo
# MIMO_API_KEY=your_mimo_api_key
# MIMO_THINKING=disabled
MIMO_API_KEY=
MIMO_THINKING=disabled

WATCH_ENABLED=false
WATCH_DIR=
WATCH_RECURSIVE=true
WATCH_INTERVAL_SECONDS=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
