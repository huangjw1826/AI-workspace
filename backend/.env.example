APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

DATA_DIR=../data
MODEL_DIR=../models/funasr
LOG_DIR=../logs
TRANSCRIPT_DIR=../data/transcripts
SUMMARY_DIR=../data/summaries
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_SECONDS=600

ASR_DEVICE=cpu
ASR_MODEL=paraformer-zh
ASR_VAD_MODEL=fsmn-vad
ASR_PUNC_MODEL=ct-punc
ASR_TIMESTAMP_MODEL=fa-zh
ASR_ENABLE_DIARIZATION=false
ASR_MAX_CONCURRENCY=1

# Supported: deepseek, tongyi/qwen, mimo
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_COMPLETION_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=3
LLM_TEMPERATURE=
LLM_TOP_P=

# Xiaomi MiMo OpenAI-compatible path:
# LLM_PROVIDER=mimo
# MIMO_API_KEY=your_mimo_api_key
# MIMO_THINKING=disabled
MIMO_API_KEY=
MIMO_THINKING=disabled

WATCH_ENABLED=false
WATCH_DIR=
WATCH_RECURSIVE=true
WATCH_INTERVAL_SECONDS=10

API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Remote Access Configuration
# Remote access is enabled by default
REMOTE_ACCESS_ENABLED=true
REMOTE_ACCESS_PROVIDER=cloudflare
REMOTE_ACCESS_HOSTNAME=
REMOTE_ACCESS_TUNNEL_NAME=ai-recorder
REMOTE_ACCESS_TUNNEL_ID=
REMOTE_ACCESS_CONFIG_PATH=
REMOTE_ACCESS_PID_PATH=
REMOTE_ACCESS_LOG_PATH=
REMOTE_ACCESS_AUTO_START=true
